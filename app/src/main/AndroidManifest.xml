<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Special access, granted by the user in system Settings; drives the
         Processes / App history screens. Requires a Play Console declaration. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- All three exist solely for the user-enabled monitoring toggles
         (CPU / network / battery readout notifications and performance
         logging, all default OFF). specialUse is the only FGS type that fits
         a continuous device-monitoring readout; Play Console asks for a
         written justification + demo video for it (CONSOLE_ANSWERS.md). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The user-enabled floating mini-monitor ("Floating monitor" toggle,
         default OFF). The special access is requested in-app the moment the
         user flips the toggle, never before. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Deliberately NO INTERNET permission: nothing ever leaves the device.
         Deliberately NO QUERY_ALL_PACKAGES: task managers are not on Play's
         permitted-use list and the declaration is a rejection/termination
         risk for a new account. Launcher-intent queries below make every
         user-facing app visible, which is the honest scope for this app;
         packages surfaced by UsageStats events resolve through it too. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SysMonApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SysMon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget (Glance). Samples on demand in-process; no
             service, no extra permissions. exported=false: APPWIDGET_UPDATE
             is a protected broadcast delivered by the system. -->
        <receiver
            android:name=".ui.widget.SysMonWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sysmon_widget_info" />
        </receiver>

        <service
            android:name=".service.CpuNotificationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- API 34+ / Play policy: state why no narrower FGS type fits. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled live CPU usage, memory, network speed and battery readouts shown as persistent silent notifications, a user-enabled always-on-top floating mini-monitor card, plus user-enabled performance logging to a local CSV file" />
        </service>
    </application>
</manifest>
