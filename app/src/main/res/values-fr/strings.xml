    <string name="settings_cpu_notification">CPU en notification</string>
    <string name="settings_cpu_notification_desc">Notification silencieuse permanente avec le relevé CPU en direct (~ marque une estimation). Consomme un peu de batterie. Après un redémarrage, elle revient à la prochaine ouverture de SysMon.</string>
    <string name="settings_net_notification">Débit réseau en notification</string>
    <string name="settings_net_notification_desc">Notification silencieuse permanente avec les débits en direct. Ne lit que les compteurs de l’appareil — SysMon n’a toujours pas d’accès Internet.</string>
    <string name="settings_bat_notification">Batterie en notification</string>
    <string name="settings_bat_notification_desc">Notification silencieuse permanente avec le relevé batterie en direct — niveau, consommation et température. Après un redémarrage, elle revient à la prochaine ouverture de SysMon.</string>
    <string name="settings_mem_notification">Mémoire en notification</string>
    <string name="settings_mem_notification_desc">Notification silencieuse permanente avec le relevé mémoire en direct — utilisée, totale et disponible. Après un redémarrage, elle revient à la prochaine ouverture de SysMon.</string>
