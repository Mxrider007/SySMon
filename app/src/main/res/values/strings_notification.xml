<?xml version="1.0" encoding="utf-8"?>
<!-- Readout notifications (user-enabled foreground service). -->
<resources>
    <string name="cpu_notif_channel_name">CPU usage readout</string>
    <string name="cpu_notif_channel_desc">Ongoing CPU readout. Shown only while enabled in SysMon settings.</string>
    <!-- %1$s = "43%" or "~43%" (~ marks the frequency estimate) or "—". -->
    <string name="cpu_notif_title">CPU %1$s</string>
    <!-- %1$s as above; %2$s = average core frequency, e.g. "1.03 GHz". -->
    <string name="cpu_notif_title_freq">CPU %1$s · %2$s</string>
    <string name="cpu_notif_text">Tap to open Performance</string>
    <string name="cpu_notif_text_estimate">Estimated from core frequencies — tap for details</string>
    <string name="cpu_notif_unavailable">CPU utilization isn\'t readable on this device</string>

    <string name="net_notif_channel_name">Network speed readout</string>
    <string name="net_notif_channel_desc">Ongoing network speed readout. Shown only while enabled in SysMon settings.</string>
    <!-- %1$s = download rate, %2$s = upload rate, e.g. "2.1 Mbps" (Task Manager convention) or "—". -->
    <string name="net_notif_title">Net ↓ %1$s · ↑ %2$s</string>
    <!-- %1$s = network name, e.g. "Wi-Fi". -->
    <string name="net_notif_text_on">%1$s — tap to open Performance</string>
    <string name="net_notif_unavailable">Network counters aren\'t readable on this device</string>

    <string name="bat_notif_channel_name">Battery readout</string>
    <string name="bat_notif_channel_desc">Ongoing battery readout. Shown only while enabled in SysMon settings.</string>
    <!-- %1$s = "84%" or "—". -->
    <string name="bat_notif_title">Battery %1$s</string>
    <!-- %1$s as above; %2$s = signed power draw, e.g. "-1.8 W" or "+412 mA". -->
    <string name="bat_notif_title_power">Battery %1$s · %2$s</string>
    <!-- %1$s = status segment, e.g. "Charging (USB) · 30.5 °C". -->
    <string name="bat_notif_text_on">%1$s — tap to open Performance</string>
    <string name="bat_notif_unavailable">Battery state isn\'t readable on this device</string>

    <string name="mem_notif_channel_name">Memory readout</string>
    <string name="mem_notif_channel_desc">Ongoing memory readout. Shown only while enabled in SysMon settings.</string>
    <!-- %1$s = "63%" or "—". -->
    <string name="mem_notif_title">Memory %1$s</string>
    <!-- %1$s as above; %2$s = used / total, e.g. "3.6 / 5.6 GB". -->
    <string name="mem_notif_title_used">Memory %1$s · %2$s</string>
    <!-- %1$s = available memory, e.g. "2.0 GB". -->
    <string name="mem_notif_text_on">%1$s available — tap to open Performance</string>
    <string name="mem_notif_unavailable">Memory state isn\'t readable on this device</string>

    <string name="log_notif_channel_name">Logging status</string>
    <string name="log_notif_channel_desc">Shown while performance logging runs with no readout notification visible.</string>
    <string name="log_notif_title">Logging performance</string>
    <string name="log_notif_text">CPU, memory, battery and network — tap to manage</string>
</resources>
