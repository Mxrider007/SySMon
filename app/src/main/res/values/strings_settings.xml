    <string name="settings_show_system_apps">Show system apps by default</string>
    <string name="settings_show_system_apps_desc">Include system apps in process and app lists</string>
    <string name="settings_cpu_notification">CPU usage in notification</string>
    <string name="settings_cpu_notification_desc">Silent, ongoing notification with the live CPU readout (~ marks an estimate). Uses a little battery while on. After a reboot it returns the next time you open SysMon.</string>
    <string name="settings_net_notification">Network speed in notification</string>
    <string name="settings_net_notification_desc">Silent, ongoing notification with live download/upload rates. Reads on-device counters only — SysMon still has no internet access.</string>
    <string name="settings_bat_notification">Battery in notification</string>
    <string name="settings_bat_notification_desc">Silent, ongoing notification with the live battery readout — level, power draw and temperature. After a reboot it returns the next time you open SysMon.</string>
    <string name="settings_mem_notification">Memory in notification</string>
    <string name="settings_mem_notification_desc">Silent, ongoing notification with the live memory readout — used, total and available. After a reboot it returns the next time you open SysMon.</string>
    <string name="settings_notification_boxes">Show usage boxes</string>
    <string name="settings_notification_boxes_desc">Adds a live usage tile to each readout notification</string>
    <string name="settings_overlay">Floating monitor</string>
    <string name="settings_overlay_desc">Small always-on-top card with live CPU, memory, network and battery — drag it anywhere, even over games. Uses a little battery while on. After a reboot it returns the next time you open SysMon.</string>
    <string name="settings_overlay_permission">Allow “Display over other apps” for SysMon, then turn the toggle on again</string>
    <string name="settings_cpu_notification_denied">Notifications are turned off for SysMon. Allow them in system settings to use this.</string>

    <!-- Logging -->
    <string name="settings_logging">Performance logging</string>
    <string name="settings_logging_desc">Records CPU, memory, battery and network to a CSV file on this device (rolling, up to 50 MB — the oldest samples drop first), even while the app is closed and the screen is off — this uses some battery. After a reboot it resumes the next time you open SysMon. Nothing leaves the device.</string>
